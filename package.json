{
  "name": "fotobeat-me",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:electron-assets": "node scripts/assert-electron-assets.mjs",
    "build:electron-safe": "npm run build && npm run check:electron-assets",
    "lint": "eslint . --quiet",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "jest --coverage && node --test tests/mediaAssetState.node.mjs",
    "typecheck": "tsc --noEmit || node -e \"console.warn('Typecheck advisory for JS workspace')\"",
    "contracts:check": "node scripts/validate-contracts.mjs",
    "prepare": "husky install",
    "release": "semantic-release"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@radix-ui/react-accordion": "1.2.13",
    "@radix-ui/react-collapsible": "1.1.13",
    "@vitejs/plugin-react": "5.0.0",
    "lucide-react": "0.468.0",
    "motion": "12.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "vite": "7.0.0",
    "zustand": "5.0.0",
    "i18next": "23.10.1",
    "react-i18next": "14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "eslint": "9.7.0",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.0",
    "tailwindcss": "4.1.17",
    "tailwindcss-animate": "1.0.7",
    "prettier": "^3.0.0",
    "jest": "^30.0.0",
    "typescript": "5.3.3",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^14.0.0",
    "@commitlint/cli": "^18.0.0",
    "@commitlint/config-conventional": "^18.0.0",
    "semantic-release": "^23.0.0",
    "@semantic-release/commit-analyzer": "^11.0.0",
    "@semantic-release/release-notes-generator": "^11.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/github": "^9.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "jest --bail --findRelatedTests"
    ]
  }
}
