{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fotobeat.me/contracts/fotobeat.render.v1.schema.json",
  "title": "FotoBeat Render Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "project", "preset", "output", "assets", "timeline"],
  "properties": {
    "schemaVersion": { "const": "fotobeat.render.v1" },
    "project": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "preset": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": ["formatId", "ratio", "width", "height", "fps", "durationSeconds"],
      "properties": {
        "formatId": { "type": "string", "enum": ["vertical", "wide", "square"] },
        "ratio": { "type": "string", "enum": ["9:16", "16:9", "1:1"] },
        "width": { "type": "integer", "minimum": 240 },
        "height": { "type": "integer", "minimum": 240 },
        "fps": { "type": "integer", "enum": [24, 30, 60] },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "container": { "type": "string", "enum": ["mp4"] }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/renderAsset" }
    },
    "audio": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/renderAsset" }
      ]
    },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/renderClip" }
    },
    "renderSettings": {
      "type": "object",
      "properties": {
        "target": { "type": "string", "enum": ["desktop-native", "browser-wasm", "saas-worker"] },
        "quality": { "type": "string", "enum": ["draft", "standard", "high"] }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "renderAsset": {
      "type": "object",
      "required": ["id", "type", "filename"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["image", "audio"] },
        "filename": { "type": "string", "minLength": 1 },
        "contentType": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": { "type": "string" },
        "source": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["local-file", "indexeddb", "remote-url", "storage-key"] },
            "ref": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "renderClip": {
      "type": "object",
      "required": ["id", "start", "duration", "assetId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "assetId": { "type": "string", "minLength": 1 },
        "effectId": { "type": "string" },
        "section": { "type": "string" },
        "crop": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
