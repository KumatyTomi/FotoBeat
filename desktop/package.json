{
  "name": "@fotobeat/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "FotoBeat.me desktop wrapper for local media and render workflows.",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "FOTOBEAT_DESKTOP_DEV_URL=http://localhost:5173 electron .",
    "dev:win": "set FOTOBEAT_DESKTOP_DEV_URL=http://localhost:5173&& electron .",
    "start": "electron .",
    "build:web": "cd .. && npm run build",
    "pack": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "41.2.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "me.fotobeat.desktop",
    "productName": "FotoBeat.me Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
